<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zzx.mapper.book.BookMapper">

    <resultMap id="BaseResultMap" type="com.zzx.bean.Book">
            <id property="id" column="id" />
            <result property="isbn" column="isbn" />
            <result property="title" column="title" />
            <result property="author" column="author" />
            <result property="publisher" column="publisher" />
            <result property="totalCount" column="total_count" />
            <result property="availableCount" column="available_count" />
    </resultMap>

    <sql id="Base_Column_List">
        id,isbn,title,author,publisher,total_count,
        available_count
    </sql>

    <select id="selectByPrimaryKey" parameterType="java.lang.Long" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List" />
        from book
        where  id = #{id}
    </select>

    <delete id="deleteByPrimaryKey" parameterType="java.lang.Long">
        delete from book
        where  id = #{id}
    </delete>
    <insert id="insert" keyColumn="id" keyProperty="id" parameterType="com.zzx.bean.Book" useGeneratedKeys="true">
        insert into book
        ( id,isbn,title,author,publisher,total_count,
        available_count)
        values (#{id},#{isbn},#{title},#{author},#{publisher},#{totalCount},
        #{availableCount})
    </insert>
    <insert id="insertSelective" keyColumn="id" keyProperty="id" parameterType="com.zzx.bean.Book" useGeneratedKeys="true">
        insert into book
        <trim prefix="(" suffix=")" suffixOverrides=",">
                <if test="id != null">id,</if>
                <if test="isbn != null">isbn,</if>
                <if test="title != null">title,</if>
                <if test="author != null">author,</if>
                <if test="publisher != null">publisher,</if>
                <if test="totalCount != null">total_count,</if>
                <if test="availableCount != null">available_count,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
                <if test="id != null">#{id},</if>
                <if test="isbn != null">#{isbn},</if>
                <if test="title != null">#{title},</if>
                <if test="author != null">#{author},</if>
                <if test="publisher != null">#{publisher},</if>
                <if test="totalCount != null">#{totalCount},</if>
                <if test="availableCount != null">#{availableCount},</if>
        </trim>
    </insert>
    <update id="updateByPrimaryKeySelective" parameterType="com.zzx.bean.Book">
        update book
        <set>
                <if test="isbn != null">
                    isbn = #{isbn},
                </if>
                <if test="title != null">
                    title = #{title},
                </if>
                <if test="author != null">
                    author = #{author},
                </if>
                <if test="publisher != null">
                    publisher = #{publisher},
                </if>
                <if test="totalCount != null">
                    total_count = #{totalCount},
                </if>
                <if test="availableCount != null">
                    available_count = #{availableCount},
                </if>
        </set>
        where   id = #{id}
    </update>
    <update id="updateByPrimaryKey" parameterType="com.zzx.bean.Book">
        update book
        set
            isbn =  #{isbn},
            title =  #{title},
            author =  #{author},
            publisher =  #{publisher},
            total_count =  #{totalCount},
            available_count =  #{availableCount}
        where   id = #{id}
    </update>
</mapper>
